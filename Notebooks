        "# Missingness flags\n",
        "deliveries$distance_missing_flag <- ifelse(is.na(deliveries$route_distance_km), 1, 0)\n",
        "complaints$comp_missing_flag <- ifelse(is.na(complaints$compensation_amount), 1, 0)"
